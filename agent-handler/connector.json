{
  "name": "HydraDB",
  "description": "Persistent agent memory: recall relevant context and ingest knowledge via HydraDB.",
  "url": "https://mcp.hydradb.com/mcp",
  "auth": {
    "type": "secret",
    "header": {
      "key": "Authorization",
      "value": "Bearer ${HYDRADB_API_KEY}"
    }
  },
  "headers": [
    {
      "key": "X-HydraDB-Database",
      "value": "${HYDRADB_DATABASE}"
    }
  ]
}
